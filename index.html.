<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AgriLink AI</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
}

body{
    background:#f5faf6;
    color:#18351f;
}

/* NAVIGATION */

nav{
    background:#126b2f;
    color:white;
    padding:18px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:25px;
    font-weight:bold;
}

.logo span{
    color:#b9f6c8;
}

nav ul{
    display:flex;
    gap:25px;
    list-style:none;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

/* HERO */

.hero{
    background:linear-gradient(135deg,#0c5c29,#2e8b46);
    color:white;
    padding:90px 7%;
}

.hero-content{
    max-width:1150px;
    margin:auto;
}

.hero h1{
    font-size:clamp(40px,6vw,70px);
    max-width:750px;
    line-height:1.05;
    margin-bottom:25px;
}

.hero p{
    font-size:20px;
    max-width:650px;
    line-height:1.6;
    margin-bottom:30px;
}

.buttons a{
    display:inline-block;
    padding:14px 24px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    margin-right:10px;
    margin-bottom:10px;
}

.primary{
    background:white;
    color:#126b2f;
}

.secondary{
    border:2px solid white;
    color:white;
}

/* SECTIONS */

section{
    padding:70px 7%;
    max-width:1200px;
    margin:auto;
}

.title{
    text-align:center;
    margin-bottom:40px;
}

.title h2{
    font-size:38px;
    color:#126b2f;
    margin-bottom:10px;
}

.title p{
    color:#65736a;
}

/* SERVICES */

.services{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.card{
    background:white;
    padding:28px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.card .icon{
    font-size:40px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:10px;
    color:#126b2f;
}

.card p{
    line-height:1.6;
    color:#617067;
}

/* DASHBOARD */

.dashboard{
    background:#eaf6ed;
    max-width:none;
}

.dashboard-box{
    max-width:1100px;
    margin:auto;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.stat{
    background:white;
    padding:25px;
    border-radius:12px;
    text-align:center;
}

.stat h3{
    font-size:28px;
    color:#126b2f;
    margin:10px 0;
}

/* MARKETPLACE */

.marketplace{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.product{
    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.product-image{
    height:150px;
    background:#dff2e3;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:65px;
}

.product-info{
    padding:20px;
}

.price{
    color:#126b2f;
    font-size:20px;
    font-weight:bold;
    margin:10px 0;
}

.buy{
    display:block;
    background:#126b2f;
    color:white;
    padding:12px;
    text-align:center;
    border-radius:7px;
    text-decoration:none;
    margin-top:15px;
}

/* AI */

.ai-section{
    background:#12351f;
    color:white;
    max-width:none;
}

.ai-box{
    max-width:800px;
    margin:auto;
    text-align:center;
}

.ai-box h2{
    font-size:40px;
    margin-bottom:15px;
}

.ai-box p{
    color:#d5e8da;
    margin-bottom:25px;
}

.ai-input{
    display:flex;
    background:white;
    padding:8px;
    border-radius:10px;
}

.ai-input input{
    flex:1;
    border:none;
    outline:none;
    padding:15px;
    font-size:16px;
}

.ai-input button{
    border:none;
    background:#126b2f;
    color:white;
    padding:0 22px;
    border-radius:7px;
    font-weight:bold;
}

/* ROLES */

.roles{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
}

.role{
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,.07);
}

.role h2{
    color:#126b2f;
    margin-bottom:15px;
}

.role button{
    margin-top:20px;
    padding:12px 20px;
    border:none;
    background:#126b2f;
    color:white;
    border-radius:7px;
    font-weight:bold;
}

/* FOOTER */

footer{
    background:#0c2113;
    color:#b9cabe;
    text-align:center;
    padding:30px;
}

/* MOBILE */

@media(max-width:800px){

    nav ul{
        display:none;
    }

    .services,
    .marketplace,
    .stats,
    .roles{
        grid-template-columns:1fr;
    }

    .hero{
        padding:65px 7%;
    }

    .hero h1{
        font-size:45px;
    }

    .ai-input{
        flex-direction:column;
        gap:8px;
    }

    .ai-input button{
        padding:14px;
    }

}

</style>
</head>


